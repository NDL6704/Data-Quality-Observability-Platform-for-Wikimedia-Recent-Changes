      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(wikimedia_consumer_throughput_total[2m]))",
          "legendFormat": "{{topic}}{{status}}{{stage}}{{rule_id}}{{severity}}{{component}}{{job}}"
