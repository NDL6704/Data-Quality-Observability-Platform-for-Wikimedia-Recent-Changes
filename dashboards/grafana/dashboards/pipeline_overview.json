{
  "uid": "wikimedia-pipeline",
  "title": "Wikimedia Pipeline Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "wikimedia",
    "observability"
  ],
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Ingest received / sec",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "wikimedia-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(wikimedia_ingest_events_total{status=\"received\"}[2m]))",
          "legendFormat": "{{topic}}{{status}}{{stage}}{{rule_id}}{{severity}}{{component}}{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Acknowledged deliveries / sec",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "wikimedia-prometheus"
