# ==============================================================================
# Wikimedia Data Quality & Observability Platform Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=local
LOG_LEVEL=INFO

# Wikimedia EventStream
WIKIMEDIA_STREAM_URL=https://stream.wikimedia.org/v2/stream/recentchange
WIKIMEDIA_USER_AGENT=WikimediaDataQualityPlatform/0.1.0 (local-dev; data-platform-portfolio)
SSE_CONNECT_TIMEOUT_SEC=15
SSE_READ_TIMEOUT_SEC=60
SSE_MAX_BACKOFF_SEC=60

# Apache Kafka (KRaft mode)
# Use localhost:9092 when running tests/scripts on host, or kafka:9092 inside Docker network
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW=rc.raw.v1
KAFKA_TOPIC_VALIDATED=rc.validated.v1
KAFKA_TOPIC_DLQ=rc.dlq.v1
KAFKA_CONSUMER_GROUP_QUALITY=rc-quality-consumer-v1
KAFKA_AUTO_OFFSET_RESET=earliest

# Quality consumer: bounded retries; failures stop without acknowledging the message
QUALITY_MAX_RETRIES=3
QUALITY_RETRY_BACKOFF_SEC=1
QUALITY_DELIVERY_TIMEOUT_SEC=10

# PostgreSQL (Curated & Metadata Store)
# Use localhost:5432 when running tests/scripts on host, or postgres:5432 inside Docker network
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wikimedia_dq
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10

# Local Raw Archive
RAW_ARCHIVE_DIR=./data/raw_archive
RAW_ARCHIVE_BATCH_SIZE=500
RAW_ARCHIVE_FLUSH_INTERVAL_SEC=30

# Observability & Metrics
# Small future timestamp tolerance only (0..5s); fix host NTP for larger offsets.
QUALITY_MAX_FUTURE_SKEW_SECONDS=2
PROMETHEUS_PORT=8000
METRICS_ENABLED=true
PROMETHEUS_URL=http://127.0.0.1:9090
CONSUMER_METRICS_PORT=8001
OBSERVABILITY_PORT=8002
OBSERVABILITY_POLL_SEC=5
# Local-only token; keep Alertmanager authorization credentials in sync when changing.
OBSERVABILITY_WEBHOOK_TOKEN=local-observability
